# Copy to .env and fill in. Never commit .env.
# Names match the live containers (docs/prod-stack.md).
POSTGRES_USER=personal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=personal
DATABASE_URL=postgresql+psycopg://personal:change-me@db:5432/personal
REDIS_URL=redis://redis:6379/0
# Bearer token for all write endpoints (POST/PUT/DELETE, /api/run)
ADMIN_TOKEN=change-me
# Comma-separated origins for CORS, e.g. https://leochai.com,https://www.leochai.com
CORS_ORIGINS=
# Public base URL used when building photo URLs
PUBLIC_BASE=https://api.leochai.com
